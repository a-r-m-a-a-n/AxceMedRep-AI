<Window x:Class="AxceMedRepAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AxceMedRep AI — Clinical Documentation &amp; Report System" 
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, sans-serif">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Safety Banner -->
        <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="0,0,0,1" Padding="12,6">
            <TextBlock Text="CLINICAL SAFETY GATE: Decision support only. Clinician verification and explicit digital signature required prior to medical record finalization."
                       FontSize="11" FontWeight="SemiBold" Foreground="#92400E" HorizontalAlignment="Center"/>
        </Border>

        <!-- App Header Bar -->
        <Border Grid.Row="1" Background="#0F172A" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel="Left">
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                        <TextBlock Text="AM" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                    </Border>
                    <TextBlock Text="AxceMedRep AI Desktop" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="· Local-First Clinical Architecture" FontSize="12" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel="Right">
                    <TextBlock Text="Dr. Sarah Chen, MD (Pediatrics · #MED-88421)" Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Upload Document" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="12,5" BorderThickness="0" Margin="0,0,8,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Dual Pane Workspace -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Document Scan Viewer -->
            <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#020617" Padding="10,6">
                        <TextBlock Text="Original Medical Source Record (Pediatric Rx - Lucas Vance)" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Scan Canvas -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Border Background="#FFFFFF" Margin="16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="20">
                            <TextBlock Text="[High-Resolution Handwritten Medical Scan Displayed with OCR Bounding Box Overlays]" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#020617" Padding="10,4">
                        <TextBlock Text="AXCEMEDREP OCR EVIDENCE GROUNDING · 96.4% CONFIDENCE" Foreground="#64748B" FontSize="10" FontFamily="Consolas"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E2E8F0"/>

            <!-- Right: Clinician Review & Structured Draft -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Clinical Review &amp; Field Verification" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Verify extracted medications, dosages, and diagnostic impressions against source ink." FontSize="11" Foreground="#64748B" Margin="0,2,0,12"/>

                        <!-- Prescription Item -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="1. Cefdinir oral suspension 125mg/5mL" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                <TextBlock Text="Sig: 7 mL (175 mg) PO QD x 10 days" FontSize="11" Foreground="#334155" Margin="0,2,0,0"/>
                                <TextBlock Text="Source Evidence: '1. Cefdinir oral suspension 125 mg / 5 mL' (Confidence 97%)" FontSize="10" FontFamily="Consolas" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Ambiguous Item Flagged -->
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="2. Children's Ibuprofen oral liquid (100 mg / 5 mL)" FontWeight="Bold" FontSize="12" Foreground="#92400E"/>
                                <TextBlock Text="Sig: 10 mL PO q6-8h PRN fever > 38.5°C" FontSize="11" Foreground="#92400E" Margin="0,2,0,0"/>
                                <TextBlock Text="LOW OCR CONFIDENCE (78%): Ambiguous handwriting in dosage volume. Verification required." FontSize="10" FontWeight="Bold" Foreground="#B45309" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Doctor Approval Bar -->
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="12" Margin="0,12,0,0">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel="Left">
                                    <TextBlock Text="Physician Explicit Sign-Off" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                    <TextBlock Text="Licensed Attestation Required for Report Compilation" FontSize="10" Foreground="#64748B"/>
                                </StackPanel>
                                <Button Content="Sign &amp; Approve Clinical Report" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,6" BorderThickness="0" DockPanel="Right"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,4">
            <StatusBarItem>
                <TextBlock Text="System Status: Connected to Local SQLite Core · AES-256 Storage Encrypted · Zero Hallucinations Verified" FontSize="11" Foreground="#64748B"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
